    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test server/*.test.ts",
    "test:hub": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test server/hub.test.ts"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
