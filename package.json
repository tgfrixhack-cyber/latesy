{
  "name": "blok-arena",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON server/index.ts",
    "dev:next": "next dev",
    "build": "next build",
    "start": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON server/index.ts --prod",
