# Домен сайта (A-запись должна указывать на IP сервера). HTTPS выпустится автоматически.
DOMAIN=api.example.com
PUBLIC_URL=https://api.example.com

# Учётка администратора (создаётся при первом запуске)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password

# Пароль базы Postgres (придумайте любой длинный)
POSTGRES_PASSWORD=change-me-db-password

# Необязательно: срок жизни сессии в часах
JWT_TTL_HOURS=168

# Вход через GitHub / Google (можно оставить пустым и заполнить в админке)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
